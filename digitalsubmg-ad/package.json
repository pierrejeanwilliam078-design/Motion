{
  "name": "digitalsubmg-ad",
  "version": "1.0.0",
  "private": true,
  "description": "DigitalSubMG — The Future of Premium Access. Publicité motion design 30 s (Remotion).",
  "scripts": {
    "assets": "python3 scripts/prepare_assets.py && python3 scripts/generate_audio.py",
    "dev": "remotion studio",
    "render": "remotion render DigitalSubAd out/digitalsubmg-ad.mp4 --codec=h264 --audio-codec=aac --audio-bitrate=320k --crf=16",
    "render:preview": "remotion render DigitalSubAd out/digitalsubmg-ad-preview.mp4 --codec=h264 --scale=0.5 --crf=22",
    "sheet": "node scripts/contact-sheet.mjs out/sheet.png 60,150,250,340,430,510,580,712,800,950,1110,1215,1330,1420,1650,1790 0.3 8",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
