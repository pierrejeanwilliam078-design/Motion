{
  "name": "gsn2-motion",
  "version": "1.0.0",
  "private": true,
  "description": "GSN 2.0 — publicité motion design 40 s (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts GSN40 out/GSN2_40s_1080p.mp4 --codec=h264 --crf=16",
    "render:4k": "remotion render src/index.ts GSN40 out/GSN2_40s_2160p.mp4 --codec=h264 --crf=16 --scale=2",
    "still": "remotion still src/index.ts GSN40 out/still.png",
    "typecheck": "tsc --noEmit",
    "audio:build": "python3 scripts/build_audio.py"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "world-atlas": "^2.0.2"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@remotion/cli": "^4.0.535",
    "@remotion/layout-utils": "^4.0.535",
    "@remotion/paths": "^4.0.535",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.535"
  }
}
