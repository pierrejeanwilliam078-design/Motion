{
  "name": "digitalsub-motion-ia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Motion design publicitaire DigitalSub (35 s, 9:16) : aperçu interactif React + Web Audio et export MP4 via Remotion.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "artifact": "vite build && node scripts/build-artifact.mjs",
    "audio": "node scripts/render-soundtrack.mjs",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "remotion render src/remotion/index.ts DigitalSubAd out/digitalsub-ia-35s.mp4",
    "typecheck": "tsc --noEmit",
    "still": "remotion still src/remotion/index.ts DigitalSubAd",
    "render:v2": "remotion render src/remotion/index.ts DigitalSubAdV2 out/digitalsub-ia-35s-v2.mp4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@remotion/cli": "^4.0.538",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.538"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
