{
  "name": "miarina-media-ad",
  "version": "1.0.0",
  "private": true,
  "description": "Publicité motion design de 55 s pour Miarina Media (Remotion, React, TypeScript)",
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "srt": "node scripts/generate-srt.mjs",
    "audio": "python3 scripts/generate-audio.py",
    "still": "remotion still MiarinaAd out/poster.png --frame=1290",
    "render": "remotion render MiarinaAd out/miarina-media-ad-16x9.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=192k",
    "render:clean": "remotion render MiarinaAd-SansSousTitres out/miarina-media-ad-16x9-clean.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=192k",
    "render:vertical": "remotion render MiarinaAd-Vertical out/miarina-media-ad-9x16.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=192k",
    "render:all": "npm run render && npm run render:clean && npm run render:vertical"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@remotion/cli": "4.0.539",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
