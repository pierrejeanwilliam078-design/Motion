{
  "name": "tiavoyages-motion",
  "version": "1.0.0",
  "private": true,
  "description": "TIAVOYAGES — publicité animée verticale 9:16 (30 s) réalisée avec Remotion",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts TiavoyagesAd out/tiavoyages-dubai-9x16.mp4 --codec=h264 --crf=16 --audio-bitrate=320k --pixel-format=yuv420p",
    "still": "remotion still src/index.ts TiavoyagesAd out/still.png --frame=200",
    "typecheck": "tsc --noEmit",
    "master": "bash tools/master.sh out/tiavoyages-dubai-9x16.mp4 out/tiavoyages-dubai-9x16-master.mp4",
    "export": "npm run render && npm run master"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
